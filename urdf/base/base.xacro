<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- declaring variables -->
    <xacro:property name="box_length" value="0.2"/>
    <xacro:property name="box_width" value="0.2"/>
    <xacro:property name="box_height" value="0.05"/>
    <xacro:property name="ground_offset" value="0.025"/>

    <!-- base_footprint -->
    <link name="base_footprint"/>

    <!-- create_box function declaration -->
    <xacro:macro name="create_box" params="prefix length width height color">

        <link name="${prefix}_box">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${length} ${width} ${height}"/>
                </geometry>
                <material name="${color}"/>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${length} ${width} ${height}"/>
                </geometry>
            </collision>

        </link>
    </xacro:macro>

        <!-- create_joint function declaration -->
   <xacro:macro name="create_joint" params="parent_link child_link type reflect x y z roll pitch yaw">
        <joint name="${parent_link}_to_${child_link}" type="${type}">
            <parent link="${parent_link}"/>
            <child link="${child_link}"/>
            <origin xyz="${reflect * x} ${reflect * y} ${reflect * z}" rpy="${roll} ${pitch} ${yaw}"/>
        </joint>
    </xacro:macro>
</robot>