<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<!-- declaring variables -->
<xacro:property name="box_length" value="0.2"/>
<xacro:property name="box_width" value="0.2"/>
<xacro:property name="box_height" value="0.05"/>
<xacro:property name="ground_offset" value="0.025"/>

    <link name="base_footprint"/>

<!-- baselink defined (base_chassis) -->
    <link name="base_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size ="${box_length} ${box_width} ${box_height}"/>
            </geometry>
            
            <material name="green"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${box_length} ${box_width} ${box_height}"/>
            </geometry>

        </collision>

    </link>

<!-- joints -->
    <joint name="base_footprint_to_base_link" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${ground_offset + box_height/2}" rpy="0 0 0"/>
    </joint>


</robot>
