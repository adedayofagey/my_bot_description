<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Properties declaarations -->
    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_width" value="0.025"/>

    <xacro:macro name="create_wheel" params="prefix radius width color">
        <link name="${prefix}_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${radius}" length="${width}"/>
                </geometry>
                <material name="${color}"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${radius}" length="${width}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

    <!-- create_wheel_joint function declaration -->
   <xacro:macro name="create_wheel_joint" params="parent_link child_link type reflect x y z roll pitch yaw axis">
        <joint name="${parent_link}_to_${child_link}" type="${type}">
            <parent link="${parent_link}"/>
            <child link="${child_link}"/>
            <origin xyz="${reflect * x} ${reflect * y} ${reflect * z}" rpy="${roll} ${pitch} ${yaw}"/>
            <axis xyz="${axis}"/>
        </joint>
    </xacro:macro>

</robot>