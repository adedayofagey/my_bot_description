<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- castor wheel properties -->
<xacro:property name="castor_radius" value="0.012"/>
<xacro:property name="castor_x_offset" value="0.075"/>

<!-- A function declaration for a castor_wheel -->
    <xacro:macro name="create_castor_wheel" params="prefix radius color">
        <link name="${prefix}_castor_wheel">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <sphere radius="${radius}"/>
                </geometry>
                <material name="${color}"/>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <sphere radius="${radius}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

</robot>