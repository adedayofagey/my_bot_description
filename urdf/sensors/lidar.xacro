<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- lidar and lidar_mount properties -->
    <xacro:property name="lidar_mount_length" value="0.035"/>
    <xacro:property name="lidar_mount_width" value="0.035"/>
    <xacro:property name="lidar_mount_height" value="0.150"/>
    <xacro:property name="lidar_mount_x_offset" value="0.0825"/>
    <xacro:property name="lidar_radius" value="0.0295"/>
    <xacro:property name="lidar_height" value="0.02"/>

    <xacro:macro name="spawn_lidar" params="radius height color">
        <link name="lidar">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${radius}" length="${height}"/>
            </geometry>
            <material name="${color}"/>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${radius}" length="${height}"/>
                </geometry>           
            </collision>
        </link>
    </xacro:macro>
</robot>
